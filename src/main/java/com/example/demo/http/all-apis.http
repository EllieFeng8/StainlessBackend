# 來源：WorkOrderDetailController.java
# 此處 workOrderCode 使用顯示編號字串，並非工單資料表 id。
# 已完成結單才能追加；targetQuantity 須大於原目標及已生產量並通過允收檢查。
POST {{baseUrl}}/work-orders/{{workOrderCode}}/assignments/{{stage}}/{{assignmentId}}/first-article/additional-production
Accept: application/json
Content-Type: application/json

{
  "reason": "追加訂單",
  "targetQuantity": 1200
}


### 58 打頭派工／驗證工單、機台與物料對應
# 來源：WorkOrderHeadingMachineController.java
# Query workOrderId：必填。
# Query headMachineId：必填。
# Query materialId：必填。
# workOrderCode/workOrderId 為工單資料表 id；路徑 id 為派工 id。
# 不需要 Body。
GET {{baseUrl}}/workOrderHeadingMachine/production/verify?workOrderId={{workOrderId}}&headMachineId={{headMachineId}}&materialId={{materialId}}
Accept: application/json


### 59 打頭派工／開工
# 來源：WorkOrderHeadingMachineController.java
# workOrderCode/workOrderId 為工單資料表 id；路徑 id 為派工 id。
# 不需要 Body；須未結單且已完成首件或符合免首檢條件；開始時間由伺服器設定。
# 不需要 Body。
POST {{baseUrl}}/workOrderHeadingMachine/{{headingAssignmentId}}/production/start
Accept: application/json


### 60 打頭派工／變更生產狀態
# 來源：WorkOrderHeadingMachineController.java
# workOrderCode/workOrderId 為工單資料表 id；路徑 id 為派工 id。
# 須已開工且未結單。生產中可省略 reason；其他非目標產量狀態需 reason。
# 可用狀態：生產中、換料、換針、目標產量設定、目標產量修改、等待、待料、待單、待沖模、待維修、待調車、無法續做、模具/牙板異常、盤元異常換料續做。
POST {{baseUrl}}/workOrderHeadingMachine/{{headingAssignmentId}}/production/status
Accept: application/json
Content-Type: application/json

{
  "productionStatus": "等待",
  "reason": "等待品質確認"
}


### 61 打頭派工／修改目標產量（同一路由另一種 Body）
# 僅已開工未結單；targetQuantity 必填且 >=0；quantityChangeReason 必填；上下偏差選填且 >=0。
POST {{baseUrl}}/workOrderHeadingMachine/{{headingAssignmentId}}/production/status
Accept: application/json
Content-Type: application/json

{
  "productionStatus": "目標產量修改",
  "targetQuantity": 1200,
  "targetUpOffsetQuantity": 50,
  "targetDownOffsetQuantity": 50,
  "quantityChangeReason": "客戶追加數量"
}


### 62 打頭派工／結單
# 來源：WorkOrderHeadingMachineController.java
# workOrderCode/workOrderId 為工單資料表 id；路徑 id 為派工 id。
# orderClosed=1 正常（自動通過）、2 異常（待審）；異常必填 reason 與 remark。
# endAt 必填且不可早於開工；materialLoss、remainingMaterial 必填且 >=0；執行前修改 endAt。
# 須已開工；異常待審/通過不能一般重送，退回後可重新結單。
POST {{baseUrl}}/workOrderHeadingMachine/{{headingAssignmentId}}/production/close
Accept: application/json
Content-Type: application/json

{
  "orderClosed": 2,
  "endAt": "{{endAt}}",
  "materialLoss": 5,
  "remainingMaterial": 20,
  "reason": "設備異常提前停工",
  "remark": "提交異常結單"
}


### 63 打頭派工／審核人員再次結單（同一路由另一種 Body）
# 僅已開工且已結單；reviewer、approved、opinion 與 orderClosed 必填，其餘省略保留原值。
POST {{baseUrl}}/workOrderHeadingMachine/{{headingAssignmentId}}/production/close
Accept: application/json
Content-Type: application/json

{
  "orderClosed": 2,
  "approved": true,
  "reviewer": "102",
  "opinion": "審核後判定異常並通過"
}


### 64 打頭派工／儲存物料用量
# 來源：WorkOrderHeadingMachineController.java
# workOrderCode/workOrderId 為工單資料表 id；路徑 id 為派工 id。
# 兩個欄位皆必填且 >=0。
POST {{baseUrl}}/workOrderHeadingMachine/{{headingAssignmentId}}/production/material
Accept: application/json
Content-Type: application/json

{
  "materialLoss": 5,
  "remainingMaterial": 20
}


### 65 打頭派工／審核結單
# 來源：WorkOrderHeadingMachineController.java
# workOrderCode/workOrderId 為工單資料表 id；路徑 id 為派工 id。
# 限已結單且待審；approved、reviewer、opinion 必填。approved=false 為退回；可另帶 orderClosed=1/2 改判。
POST {{baseUrl}}/workOrderHeadingMachine/{{headingAssignmentId}}/production/review
Accept: application/json
Content-Type: application/json

{
  "approved": true,
  "reviewer": "102",
  "opinion": "確認數量與物料資料無誤"
}


