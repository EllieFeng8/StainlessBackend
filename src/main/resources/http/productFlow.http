### A4a 正常結單（與 4b 擇一）；成功 200
POST {{baseUrl}}/workOrderHeadingMachine/{{headProductionAssignmentId}}/production/close
Accept: application/json
Content-Type: application/json

{
  "order_closed": 1,
  "end_at": "{{endAt}}",
  "material_loss": 2.5,
  "remaining_material": 12,
  "remark": "正常完成"
}

### A4b 異常結單／正常改異常／退回後補正；成功 200，原因備註缺漏 400
POST {{baseUrl}}/workOrderHeadingMachine/{{headProductionAssignmentId}}/production/close
Accept: application/json
Content-Type: application/json

{
  "order_closed": 2,
  "reason": "模具牙板異常",
  "remark": "牙板損壞，未達目標產量，申請異常結單",
  "end_at": "{{endAt}}",
  "material_loss": 3.5,
  "remaining_material": 19
}

### A5a 異常審核通過（與 5b 擇一）；成功 200，非待審 409
POST {{baseUrl}}/workOrderHeadingMachine/{{headProductionAssignmentId}}/production/review
Accept: application/json
Content-Type: application/json

{
  "approved": true,
  "reviewer": "{{reviewer}}",
  "remark": "已確認異常原因、耗損與餘料"
}

### A5b 異常審核退回；補正後重送 4b
POST {{baseUrl}}/workOrderHeadingMachine/{{headProductionAssignmentId}}/production/review
Accept: application/json
Content-Type: application/json

{
  "approved": false,
  "reviewer": "{{reviewer}}",
  "remark": "請補充異常原因及餘料盤點結果"
}

### A6 查結果，核對 orderClosed / endAt / materialLoss / remainingMaterial
GET {{baseUrl}}/workOrderHeadingMachine/getWorkOrderHeadingMachine/{{headProductionAssignmentId}}
Accept: application/json

### B1 核對工單＋機台＋物料；無符合 404
GET {{baseUrl}}/workOrderThreadingMachine/getWorkOrderThreadingMachine?workOrderId={{workOrderId}}&threadMachineId={{threadMachineId}}&materialId={{threadMaterialId}}
Accept: application/json

> {%
    client.global.clear("threadProductionAssignmentId");
    client.test("唯一符合的派工", function () {
        client.assert(response.status === 200 && Array.isArray(response.body) && response.body.length === 1, "無符合或多筆派工，請人工確認");
    });
    if (response.status === 200 && Array.isArray(response.body) && response.body.length === 1) {
        client.global.set("threadProductionAssignmentId", response.body[0].id);
    }
%}

